#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/schema-utils@4.8.3_webpack@5.112.2/node_modules/schema-utils/node_modules:/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/schema-utils@4.8.3_webpack@5.112.2/node_modules:/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/schema-utils@4.8.3_webpack@5.112.2/node_modules/schema-utils/node_modules:/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/schema-utils@4.8.3_webpack@5.112.2/node_modules:/home/maxdb/Documents/DeckyUpSnap/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../schema-utils/bin/schema-utils.js" "$@"
else
  exec node  "$basedir/../schema-utils/bin/schema-utils.js" "$@"
fi
